@model List<ServiceCategory>
@{
    ViewData["Title"] = "Manage Categories";
    Layout = "_AdminLayout";
}

<h1 class="admin-page-title">Service Categories</h1>
<p style="margin-bottom:1.5rem;"><a asp-controller="AdminServices" asp-action="Index" style="color:var(--rose-gold);">&larr; Back to Services</a></p>

<div class="crud-form">
    <h3>&#10133; Add New Category</h3>
    <form asp-controller="AdminServices" asp-action="CreateCategory" method="post">
        @Html.AntiForgeryToken()
        <div class="crud-form-grid">
            <div class="form-group">
                <label>Category Name</label>
                <input type="text" name="name" required />
            </div>
            <div class="form-group">
                <label>Icon (emoji)</label>
                <input type="text" name="icon" placeholder="e.g. 💆" />
            </div>
            <div class="form-group">
                <label>Display Order</label>
                <input type="number" name="displayOrder" value="@(Model.Count + 1)" />
            </div>
            <button type="submit" class="btn btn-gold btn-sm">Add Category</button>
        </div>
    </form>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>Icon</th><th>Name</th><th>Services Count</th><th>Order</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>@cat.Icon</td>
                    <td>@cat.Name</td>
                    <td>@cat.Services.Count</td>
                    <td>@cat.DisplayOrder</td>
                    <td>
                        <form asp-controller="AdminServices" asp-action="DeleteCategory" method="post" class="inline-form" onsubmit="return confirm('Delete this category? Only possible if it has no services.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@cat.Id" />
                            <button type="submit" class="btn-delete">&#128465;</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
