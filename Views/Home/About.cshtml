@{
    ViewData["Title"] = "About Us";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Our Story</p>
        <h1>About Laksh Beauty and Bridal Studio</h1>
    </div>
</section>

<section class="section about-section">
    <div class="container about-grid">
        <div>
            <div class="about-img-wrap">
                <img src="https://images.pexels.com/photos/7750091/pexels-photo-7750091.jpeg?auto=compress&cs=tinysrgb&w=900" alt="Laksh Beauty and Bridal Studio interior" class="about-img" />
            </div>
            <p>Welcome to <strong>Laksh Beauty and Bridal Studio</strong>, where beauty meets elegance. With 4+ years of experience in the beauty and wellness industry, we are dedicated to helping our clients look and feel their absolute best.</p>
            <p>Our team of skilled beauty professionals specializes in bridal makeup, hairstyling, skincare, hair care, nail services, and beauty treatments, using high-quality products and the latest techniques to deliver exceptional results.</p>
            <p>Whether you're preparing for your wedding, a special occasion, or simply treating yourself, we provide personalized services in a clean, comfortable, and relaxing environment. Customer satisfaction, hygiene, and attention to detail are at the heart of everything we do.</p>
        </div>
        <div class="why-choose-box">
            <h3>✨ Why Choose Us?</h3>
            <ul>
                <li>💄 4+ Years of Professional Experience</li>
                <li>👩‍🎨 Certified &amp; Experienced Beauty Experts</li>
                <li>🌿 Premium Quality Beauty Products</li>
                <li>🧼 Hygienic &amp; Sanitized Environment</li>
                <li>💖 Personalized Beauty Solutions</li>
                <li>💰 Affordable &amp; Transparent Pricing</li>
                <li>📅 Easy Online Appointment Booking</li>
                <li>😊 Friendly Customer Service</li>
                <li>⭐ Trusted by Hundreds of Happy Clients</li>
            </ul>
        </div>
    </div>

    <div class="container counters-grid" style="margin-top:3rem;">
        <div class="counter-item"><span class="num">4+</span><span class="label">Years of Experience</span></div>
        <div class="counter-item"><span class="num">1000+</span><span class="label">Happy Clients</span></div>
        <div class="counter-item"><span class="num">500+</span><span class="label">Bridal Makeovers</span></div>
        <div class="counter-item"><span class="num">25+</span><span class="label">Beauty &amp; Hair Services</span></div>
        <div class="counter-item"><span class="num">4.9★</span><span class="label">Customer Rating</span></div>
    </div>

    <div class="container center" style="margin-top:2.5rem;">
        <a class="btn btn-gold" asp-controller="Appointment" asp-action="Book">Book Your Appointment</a>
    </div>
</section>
