@model List<ServiceCategory>
@using LakshBeautyStudio.Models
@{
    ViewData["Title"] = "Pricing";
    var packages = ViewBag.Packages as List<Package> ?? new List<Package>();
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Transparent Pricing</p>
        <h1>Service &amp; Package Prices</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2 class="section-title">💎 Package Prices</h2>
        <div class="price-table">
            @foreach (var pkg in packages)
            {
                <div class="price-row">
                    <span class="p-name">@pkg.Name</span>
                    <span class="p-price">₹@pkg.Price.ToString("N0")</span>
                </div>
            }
        </div>

        @foreach (var category in Model)
        {
            <h2 class="section-title category-title" style="margin-top:3rem;"><span class="icon-chip">@category.Icon</span> @category.Name</h2>
            <div class="price-table">
                @foreach (var service in category.Services)
                {
                    <div class="price-row">
                        <span class="p-name">@service.Name</span>
                        <span class="p-price">Starting ₹@service.StartingPrice.ToString("N0")</span>
                    </div>
                }
            </div>
        }

        <div class="center" style="margin-top:2.5rem;">
            <a class="btn btn-gold" asp-controller="Appointment" asp-action="Book">Book an Appointment</a>
        </div>
    </div>
</section>
