@model List<FAQ>
@{
    ViewData["Title"] = "FAQ";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Need Help?</p>
        <h1>Frequently Asked Questions</h1>
    </div>
</section>

<section class="section">
    <div class="container faq-container">
        @if (!Model.Any())
        {
            <p class="empty-state">FAQs will appear here soon.</p>
        }
        @foreach (var faq in Model)
        {
            <div class="faq-item">
                <button class="faq-question" type="button">
                    <span>@faq.Question</span>
                    <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                    <p>@faq.Answer</p>
                </div>
            </div>
        }

        <div class="center" style="margin-top:2.5rem;">
            <p>Still have questions?</p>
            <a class="btn btn-outline" href="https://api.whatsapp.com/send?phone=919585885247" target="_blank" rel="noopener">Ask on WhatsApp</a>
        </div>
    </div>
</section>
