@model List<Appointment>
@{
    ViewData["Title"] = "Manage Appointments";
    Layout = "_AdminLayout";
}

<h1 class="admin-page-title">Appointments</h1>

<div class="filter-tabs">
    <a asp-controller="Admin" asp-action="Appointments" class="@(ViewBag.SelectedStatus == null ? "active" : "")">All</a>
    <a asp-controller="Admin" asp-action="Appointments" asp-route-status="Pending" class="@(ViewBag.SelectedStatus == "Pending" ? "active" : "")">Pending</a>
    <a asp-controller="Admin" asp-action="Appointments" asp-route-status="Confirmed" class="@(ViewBag.SelectedStatus == "Confirmed" ? "active" : "")">Confirmed</a>
    <a asp-controller="Admin" asp-action="Appointments" asp-route-status="Completed" class="@(ViewBag.SelectedStatus == "Completed" ? "active" : "")">Completed</a>
    <a asp-controller="Admin" asp-action="Appointments" asp-route-status="Cancelled" class="@(ViewBag.SelectedStatus == "Cancelled" ? "active" : "")">Cancelled</a>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Service</th>
                <th>Date</th>
                <th>Time</th>
                <th>Message</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="empty-state">No appointments found.</td></tr>
            }
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Name</td>
                    <td><a href="tel:+91@a.Phone">@a.Phone</a></td>
                    <td>@a.Service</td>
                    <td>@a.PreferredDate.ToString("dd-MM-yyyy")</td>
                    <td>@a.PreferredTime</td>
                    <td>@(string.IsNullOrEmpty(a.Message) ? "-" : a.Message)</td>
                    <td><span class="status-badge status-@a.Status.ToString().ToLower()">@a.Status</span></td>
                    <td class="actions-cell">
                        <form asp-controller="Admin" asp-action="UpdateStatus" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <select name="status" onchange="this.form.submit()">
                                <option value="Pending" selected="@(a.Status == AppointmentStatus.Pending)">Pending</option>
                                <option value="Confirmed" selected="@(a.Status == AppointmentStatus.Confirmed)">Confirmed</option>
                                <option value="Completed" selected="@(a.Status == AppointmentStatus.Completed)">Completed</option>
                                <option value="Cancelled" selected="@(a.Status == AppointmentStatus.Cancelled)">Cancelled</option>
                            </select>
                        </form>
                        <form asp-controller="Admin" asp-action="DeleteAppointment" method="post" class="inline-form" onsubmit="return confirm('Delete this appointment?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn-delete">🗑</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
