@{
    ViewData["Title"] = "Change Password";
    Layout = "_AdminLayout";
}

<h1 class="admin-page-title">Change Password</h1>

@if (ViewBag.Success != null)
{
    <div class="alert-success">@ViewBag.Success</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert-error-box">@ViewBag.Error</div>
}

<div class="crud-form" style="max-width:420px;">
    <form asp-controller="Admin" asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" required />
        </div>
        <div class="form-group">
            <label>New Password</label>
            <input type="password" name="newPassword" required minlength="6" />
        </div>
        <div class="form-group">
            <label>Confirm New Password</label>
            <input type="password" name="confirmPassword" required minlength="6" />
        </div>
        <button type="submit" class="btn btn-gold btn-block">Update Password</button>
    </form>
</div>
